<mvc:View controllerName="com.demo.firstproject.controller.View2"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m" xmlns:layout="sap.ui.layout">
    <Page id="page2" title="i am view 2" showNavButton="true" navButtonPress="onPressBack">
        <content>
            
                <!-- <Button id="button2" text="Back to View 1" press="onPressBack"/> -->
                 <!-- First panel  -->
            <Panel headerText="Employee Details 2" expanded="true">
                <layout:Grid defaultSpan=" L6 M6 " vSpacing="0">
                <layout:content>
                
                    <Label text="Employee Id" class="sapUiTinyMarginTop"></Label>
                    <Input ></Input>
                    <Label text="Employee Name" class="sapUiTinyMarginTop"></Label>
                    <Input ></Input>
                    <Label text="Employee Designation" class="sapUiTinyMarginTop"></Label>
                    <Input ></Input>
                    <Label text="Employee Skill" class="sapUiTinyMarginTop"></Label>
                    <Input ></Input>
                    <Label text="Employee Email" class="sapUiTinyMarginTop"></Label>
                    <Input ></Input>
                    <Label text="Employee Phone" class="sapUiTinyMarginTop"></Label>
                    <Input ></Input>
                </layout:content>
            </layout:Grid>        
            </Panel>

            <!-- second panel -->
            <Panel headerText="Employee Details" expandable="true">
                <layout:Grid defaultSpan=" L3 M3 " vSpacing="0">
                <layout:content>
                
                    <Label text="Employee Id" class="sapUiTinyMarginTop"></Label>
                    <Input ></Input>
                    <Label text="Employee Name" class="sapUiTinyMarginTop"></Label>
                    <Input ></Input>
                    <Label text="Employee Designation" class="sapUiTinyMarginTop"></Label>
                    <Input ></Input>
                    <Label text="Employee Skill" class="sapUiTinyMarginTop"></Label>
                    <Input ></Input>
                    <Label text="Employee Email" class="sapUiTinyMarginTop"></Label>
                    <Input ></Input>
                    <Label text="Employee Phone" class="sapUiTinyMarginTop"></Label>
                    <Input ></Input>
                </layout:content>

            
            </layout:Grid>        
            </Panel>
       
            <!-- panel 3 (3 fields per row ) -->
            <Panel headerText="Employee Details 3 (3 fields per row)" expandable="true">
                <layout:Grid defaultSpan=" L2 M2 " vSpacing="0">
                <layout:content>
                    <Label text="Employee Id" class="sapUiTinyMarginTop"></Label>
                    <Input ></Input>
                    <Label text="Employee Name" class="sapUiTinyMarginTop"></Label>
                    <Input ></Input>
                    <Label text="Employee Designation" class="sapUiTinyMarginTop"></Label>
                    <Input ></Input>
                    <Label text="Employee Skill" class="sapUiTinyMarginTop"></Label>
                    <Input ></Input>
                    <Label text="Employee Email" class="sapUiTinyMarginTop"></Label>
                    <Input ></Input>
                    <Label text="Employee Phone" class="sapUiTinyMarginTop"></Label>
                    <Input ></Input>
                </layout:content>
            </layout:Grid>        
            </Panel>
            <!-- panel 4 (Zig zag panel ) -->
            <Panel headerText="Employee Details 4 (Zig zag panel)" expandable="true">
                <!-- do not add default span in this grid -->
                <layout:Grid  vSpacing="0">
                <layout:content>
                    <Label text="Employee Name" class="sapUiTinyMarginTop"><layoutData><layout:GridData span="L3 M3"/></layoutData></Label>
                    <Input ><layoutData><layout:GridData span="L9 M9"/></layoutData></Input>
                    <Label text="Employee Id" class="sapUiTinyMarginTop"><layoutData><layout:GridData span="L3 M3"/></layoutData></Label>
                    <Input ><layoutData><layout:GridData span="L3 M3"/></layoutData></Input>
                    <Label text="Employee Designation" class="sapUiTinyMarginTop"><layoutData><layout:GridData span="L3 M3"/></layoutData></Label>
                    <Input ><layoutData><layout:GridData span="L3 M3"/></layoutData></Input>
                    <Label text="Employee Skill" class="sapUiTinyMarginTop"><layoutData><layout:GridData span="L3 M3"/></layoutData></Label>
                    <Input ><layoutData><layout:GridData span="L9 M9"/></layoutData></Input>
                    <Label text="Employee Email" class="sapUiTinyMarginTop"></Label>
                    <Input ></Input>
                    <Label text="Employee Phone" class="sapUiTinyMarginTop"></Label>
                    <Input ></Input>
                </layout:content>
            </layout:Grid>        
            </Panel>
        </content>

        <footer>
            <Bar >
                <contentRight>
                    <Button text="Save" type="Accept"></Button>
                </contentRight>
            </Bar>
        </footer>
    </Page>
</mvc:View>