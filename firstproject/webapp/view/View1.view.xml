<mvc:View controllerName="com.demo.firstproject.controller.View1"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m">
    <Page id="page" title="i am view 1">
        <content>
           
            <Text class="mytextfontsize " id="heading" text="Hello, World!" width="100%" textAlign="Center"/>
           <Label text="Enter your Name :" required="true" class="sapUiSmallMarginBegin sapUiTinyMarginTop"></Label>
           <Input id="nameInput" enabled="true" width="80%" maxLength="100" class="sapUiSmallMarginBegin"></Input>
           <Label text="Enter your Mobile Number :" required="true" class="sapUiSmallMarginBegin sapUiTinyMarginTop"></Label> 
           <Input id="mobileInput" enabled="true" width="80%" maxLength="100" class="sapUiSmallMarginBegin"></Input>
           <Label text="Enter your Email :" required="true" class="sapUiSmallMarginBegin sapUiTinyMarginTop"></Label>
           <Input id="emailInput" enabled="true" width="80%" maxLength="100" class="sapUiSmallMarginBegin"></Input>
           <Button id="submitbtn" text="Submit" type="Emphasized" class="sapUiSmallMarginBegin" press="onSubmit"></Button>
            <Button id="button" text="Press Me" press="onPress"/>
           <Button text="View 3" press="onPress3"></Button>

            <Text id="nameData" width="100%" text=""></Text>
            <Text id="mobileData" width="100%" text=""></Text>
            <Text id="emailData" width="100%" text=""></Text>
            
        </content>
        <footer>
            <Bar  >
                <contentRight>
                    <Button text="Save" type="Accept"></Button>
                </contentRight>
            </Bar>
        </footer>
    </Page>
</mvc:View>